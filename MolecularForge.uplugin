{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"EngineVersion": "5.8.0",
	"FriendlyName": "MolecularForge - Protein & Molecule Visualization",
	"Description": "Load protein and molecule structures from PDB and mmCIF files, from the RCSB Protein Data Bank or from the AlphaFold database, and render them as space-filling, ball-and-stick, backbone, cartoon or Gaussian surface. Includes DSSP secondary structure, a PyMOL-style selection language, DCD trajectory playback and a Mass-based mesoscale crowding simulation.",
	"Category": "Code Plugins",
	"CreatedBy": "Simulated Flow",
	"CreatedByURL": "https://github.com/SimulatedFlow",
	"DocsURL": "https://github.com/SimulatedFlow/ue-plugin-MolecularForge",
	"MarketplaceURL": "",
	"SupportURL": "mailto:simulatedflow@gmail.com",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "MolecularForgeRuntime",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "MolecularForgeRender",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "MolecularForgeWeb",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "MolecularForgeNiagara",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "MolecularForgeMass",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		},
		{
			"Name": "Niagara",
			"Enabled": true
		},
		{
			"Name": "MassGameplay",
			"Enabled": true
